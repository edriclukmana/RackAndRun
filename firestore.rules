rules_version = '2';

// Rack & Run only uses two collections: one document per table, and short-lived
// locks that stop two devices from running the same bot turn. Every device signs
// in anonymously, so "signed in" means "has the app open".
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{tableId} {
      allow read, write: if request.auth != null;
    }
    match /locks/{lockId} {
      allow read, write: if request.auth != null;
    }
  }
}
